# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Get your xAI API Key here for chat and image models: https://console.x.ai/
XAI_API_KEY=****

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
# Runtime prefers BK_POSTGRES_URL first, then falls back to POSTGRES_URL.
BK_POSTGRES_URL=****
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Memory (short-term)
MEMORY_SLICE=1
MEMORY_MIN_TURNS=5
MEMORY_LAST_K=5
MEMORY_MIN_TOKENS=400
MEMORY_MIN_SALIENCE=3
MEMORY_LAST_K_MAX=10
# VENICE_API_KEY=****  # Optional: if set, chat models use Venice API instead of OpenRouter
# SUMMARIZER_MODEL=deepseek/deepseek-v3.2  # Optional: Override default summarizer model
# SUMMARIZER_FALLBACK=google/gemma-4-31b-it  # Optional: Override summarizer fallback model

# Stall Detection (scene looping prevention)
STALL_THRESHOLD=3  # Consecutive non-advancing turns before injection (default: 3)
STALL_HARD_THRESHOLD=5  # Consecutive stall turns before hard break directive (default: 5)

# Google integration via workspace-connect
# Server-side only. Never prefix with NEXT_PUBLIC_.
# The signing secret must match the workspace-connect service exactly.
WORKSPACE_CONNECT_BASE_URL=http://localhost:8000
WORKSPACE_CONNECT_SIGNING_SECRET=****
WORKSPACE_CONNECT_APPLICATION_ID=ash-test
WORKSPACE_CONNECT_RETURN_URL=http://localhost:3000/settings/integrations

# Public web research via Brave Search (server-side only).
BRAVE_API_KEY=****
RESEARCH_CHAT_MAX_OUTPUT_TOKENS=3200
BRAVE_SEARCH_COUNTRY=GB
BRAVE_SEARCH_LANGUAGE=en
BRAVE_SEARCH_TIMEOUT_MS=30000
BRAVE_SEARCH_MAX_CALLS=5

# Read-only retrieval for specific public pages discovered through Brave.
# Server-side only. Fetch is not a browser or automation capability.
TINYFISH_API_KEY=****
TINYFISH_FETCH_TIMEOUT_MS=120000
TINYFISH_FETCH_MAX_CONTENT_CHARS=32000

# Trusted timezone injected into every agent request.
ASH_TIME_ZONE=Europe/London

# Stronger synthesis model for fresh, contested, or explicitly researched turns.
RESEARCH_CHAT_MODEL=openai/gpt-5.6-luna-pro
RESEARCH_CHAT_FALLBACK_MODEL=openai/gpt-5.6-luna

# Low-cost semantic classifier used before agent routing (server-side only).
EPISTEMIC_POLICY_MODEL=google/gemini-3.1-flash-lite
EPISTEMIC_POLICY_TIMEOUT_MS=8000
